<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:defaultFocusHighlightEnabled="false"
    tools:context="org.yuzu.yuzu_emu.fragments.EmulationFragment"
    tools:openDrawer="start">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/emulation_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 游戏屏幕布局管理器 - 支持四面边缘调整大小 -->
            <org.yuzu.yuzu_emu.views.GameScreenLayoutManager
                android:id="@+id/game_screen_layout_manager"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- 游戏背景图片 - 放在 SurfaceView 下面 -->
                <ImageView
                    android:id="@+id/game_background_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:importantForAccessibility="no" />

                <!-- This is what everything is rendered to during emulation -->
                <org.yuzu.yuzu_emu.views.FixedRatioSurfaceView
                    android:id="@+id/surface_emulation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:defaultFocusHighlightEnabled="false"
                    android:background="@android:color/transparent" />

            </org.yuzu.yuzu_emu.views.GameScreenLayoutManager>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/loading_indicator"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:focusable="false"
                android:defaultFocusHighlightEnabled="false"
                android:clickable="false"
                app:rippleColor="@android:color/transparent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/loading_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal">

                    <ProgressBar
                        android:id="@+id/progress_bar"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toTopOf="@id/loading_text"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/loading_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading_message"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/progress_bar" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 覆盖在模拟器上面的设置按钮 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_settings_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_quick_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_pause"
                    android:src="@drawable/ic_pause" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_settings_outer_landscape"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginEnd="68dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_quick_settings_landscape"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_pause"
                    android:src="@drawable/ic_pause" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_save_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="56dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_quick_save"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/quick_save"
                    android:src="@drawable/ic_add" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quick_load_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="104dp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_quick_load"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/quick_load"
                    android:src="@drawable/ic_add" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/frame_abuttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="34dp"
                android:layout_marginBottom="56dp"
                android:orientation="vertical">

                <include layout="@layout/fragment_emulation_buttons" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/frame_select_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="34dp"
                android:layout_marginBottom="56dp"
                android:orientation="vertical">

                <include layout="@layout/fragment_emulation_select_back" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/frame_stick_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="56dp"
                android:layout_marginBottom="200dp"
                android:orientation="vertical">

                <include layout="@layout/fragment_emulation_stick" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/frame_stick_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="56dp"
                android:layout_marginBottom="200dp"
                android:orientation="vertical">

                <include layout="@layout/fragment_emulation_stick" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/frame_shoulders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:id="@+id/frame_l_shoulder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/fragment_emulation_shoulder" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/frame_r_shoulder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/fragment_emulation_shoulder" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/frame_triggers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="100dp"
                android:paddingEnd="18dp">

                <LinearLayout
                    android:id="@+id/frame_l_trigger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/fragment_emulation_trigger" />

                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/frame_r_trigger"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include layout="@layout/fragment_emulation_trigger" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_exit_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_exit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_pause"
                    android:src="@drawable/ic_back" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_stop_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="56dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_stop"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_pause"
                    android:src="@drawable/ic_pause" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_screenshot_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="104dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_screenshot"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_pause"
                    android:src="@drawable/ic_screenshot" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_cheats_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="152dp"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_cheats"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cheats"
                    android:src="@drawable/ic_cheats" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/button_download_outer"
                style="?attr/materialCardViewOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="8dp"
                android:layout_marginTop="56dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:rippleColor="@android:color/transparent">

                <ImageButton
                    android:id="@+id/button_download"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu_download"
                    android:src="@drawable/ic_add" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/download_applet_indicator"
            style="?attr/materialCardViewOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="32dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:drawablePadding="8dp"
                android:text="@string/download_applet"
                app:drawableStartCompat="@drawable/ic_info" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/emulation_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
